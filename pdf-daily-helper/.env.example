# Copy this file to .env and edit the settings

# Port to listen on (example: 3000)
PORT=

# MongoDB database URL (example: mongodb://localhost/dbname)
DATABASE_URL=

# Session secret string (must be unique to your server)
SESSION_SECRET=

# OpenAI API key for embeddings and chat completions
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Supabase configuration for vector storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EMBEDDINGS_TABLE=pdf_chunks
SUPABASE_MATCH_RPC=match_pdf_chunks

# Logging & rate limits
LOG_LEVEL=info
API_RATE_WINDOW_MS=900000
API_RATE_MAX=200
CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_MAX=30

# Optional OCR settings
OCR_PROVIDER=
# When OCR_PROVIDER=azure
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=
OCR_TRIGGER_IF_TEXT_BELOW=40
