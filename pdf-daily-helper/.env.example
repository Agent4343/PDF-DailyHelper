# Copy this file to .env and edit the settings

# ====================
# Required Settings
# ====================

# MongoDB database URL
# Local development: mongodb://localhost/pdfhelper
# Production (MongoDB Atlas): mongodb+srv://username:password@cluster.mongodb.net/pdfhelper
DATABASE_URL=

# JWT/Session secret string (must be unique and secure)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ====================
# Optional Settings
# ====================

# Port to listen on (default: 3000)
PORT=3000

# Node environment (development or production)
NODE_ENV=development

# ====================
# Vercel Deployment
# ====================

# Vercel Blob Storage token (required for file uploads on Vercel)
# Get this from: https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN=

# ====================
# Algolia Search (Optional)
# ====================

# If you want to use Algolia for search instead of MongoDB text search
# ALGOLIA_APP_ID=
# ALGOLIA_API_KEY=
