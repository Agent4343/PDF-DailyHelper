<!DOCTYPE html>
<html lang="en">
<%- include('partials/_head.ejs') %>
<body>
<%- include('partials/_header.ejs') %>

<main class="container mt-4 chat-container" role="main">
  <h1>Chat with Your PDFs</h1>

  <div id="chatMessages" class="card chat-messages" aria-live="polite" aria-label="Chat transcript">
    <div class="card-body">
      <p class="text-muted mb-0">Ask a question to get started.</p>
    </div>
  </div>

  <form id="chatForm" class="mt-3">
    <div class="mb-3">
      <label for="chatInput" class="form-label">Your question</label>
      <textarea class="form-control" id="chatInput" name="message" rows="3" placeholder="What would you like to know?" required></textarea>
    </div>
    <div class="d-flex align-items-center gap-3">
      <button type="submit" class="btn btn-primary" id="chatSubmit">Send</button>
      <div id="chatStatus" class="text-muted" role="status" aria-live="polite" hidden></div>
    </div>
  </form>
</main>

<%- include('partials/_footer.ejs', { extraScripts: ['/js/chat.js'] }) %>
</body>
</html>
