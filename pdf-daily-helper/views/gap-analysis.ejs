<!DOCTYPE html>
<html lang="en">
<%- include('partials/_head.ejs') %>
<style>
  .doc-selector {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1rem;
  }
  .doc-selector h5 {
    color: #495057;
    margin-bottom: 1rem;
  }
  .analysis-result {
    background: white;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    padding: 1.5rem;
    margin-top: 1.5rem;
  }
  .analysis-result h5 {
    border-bottom: 2px solid #0d6efd;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }
  .analysis-content {
    white-space: pre-wrap;
    line-height: 1.7;
  }
  .analysis-content h2 {
    color: #0d6efd;
    font-size: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid #e9ecef;
    padding-bottom: 0.5rem;
  }
  .analysis-content ul {
    margin-bottom: 1rem;
  }
  .analysis-content li {
    margin-bottom: 0.5rem;
  }
  .loading-spinner {
    display: none;
    text-align: center;
    padding: 3rem;
  }
  .loading-spinner.show {
    display: block;
  }
  .doc-info {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .doc-badge {
    background: #e9ecef;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-size: 0.9rem;
  }
  .doc-badge strong {
    color: #0d6efd;
  }
  .truncation-warning {
    background: #fff3cd;
    border: 1px solid #ffc107;
    border-radius: 6px;
    padding: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }
  .swap-btn {
    cursor: pointer;
    font-size: 1.5rem;
    color: #6c757d;
    transition: color 0.2s;
  }
  .swap-btn:hover {
    color: #0d6efd;
  }
</style>
<body>
<%- include('partials/_header.ejs') %>

<main class="container mt-4" role="main">
  <h1>Gap Analysis</h1>
  <p class="text-muted">Compare two documents to identify differences, gaps, and common topics.</p>

  <div class="row mt-4">
    <div class="col-md-5">
      <div class="doc-selector">
        <h5>Document A</h5>
        <select class="form-select" id="docA">
          <option value="">Select first document...</option>
          <% documents.forEach(doc => { %>
            <option value="<%= doc.id %>"><%= doc.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="col-md-2 d-flex align-items-center justify-content-center">
      <span class="swap-btn" onclick="swapDocuments()" title="Swap documents">⇄</span>
    </div>

    <div class="col-md-5">
      <div class="doc-selector">
        <h5>Document B</h5>
        <select class="form-select" id="docB">
          <option value="">Select second document...</option>
          <% documents.forEach(doc => { %>
            <option value="<%= doc.id %>"><%= doc.name %></option>
          <% }) %>
        </select>
      </div>
    </div>
  </div>

  <div class="text-center mt-3">
    <button class="btn btn-primary btn-lg" id="analyzeBtn" onclick="runAnalysis()">
      Analyze Gaps
    </button>
  </div>

  <div class="loading-spinner" id="loading">
    <div class="spinner-border text-primary" role="status">
      <span class="visually-hidden">Loading...</span>
    </div>
    <p class="mt-3 text-muted">Analyzing documents... This may take a moment.</p>
  </div>

  <div id="resultContainer" style="display: none;">
    <div class="analysis-result">
      <div class="doc-info" id="docInfo"></div>
      <div id="truncationWarning" class="truncation-warning" style="display: none;">
        Note: Documents were truncated for analysis due to length. Results cover the first portions of each document.
      </div>
      <h5>Analysis Results</h5>
      <div class="analysis-content" id="analysisContent"></div>
    </div>
  </div>

  <div id="errorContainer" class="alert alert-danger mt-4" style="display: none;"></div>
</main>

<%- include('partials/_footer.ejs') %>

<script>
  const docASelect = document.getElementById('docA');
  const docBSelect = document.getElementById('docB');
  const analyzeBtn = document.getElementById('analyzeBtn');
  const loading = document.getElementById('loading');
  const resultContainer = document.getElementById('resultContainer');
  const errorContainer = document.getElementById('errorContainer');

  function swapDocuments() {
    const temp = docASelect.value;
    docASelect.value = docBSelect.value;
    docBSelect.value = temp;
  }

  function formatAnalysis(text) {
    // Convert markdown-style headers and formatting to HTML
    return text
      .replace(/^## (.+)$/gm, '<h2>$1</h2>')
      .replace(/^### (.+)$/gm, '<h3>$1</h3>')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/^- (.+)$/gm, '<li>$1</li>')
      .replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>')
      .replace(/\n\n/g, '</p><p>')
      .replace(/^(.+)$/gm, function(match) {
        if (match.startsWith('<')) return match;
        return match;
      });
  }

  async function runAnalysis() {
    const docId1 = docASelect.value;
    const docId2 = docBSelect.value;

    if (!docId1 || !docId2) {
      alert('Please select two documents to compare.');
      return;
    }

    if (docId1 === docId2) {
      alert('Please select two different documents.');
      return;
    }

    // Show loading, hide results
    loading.classList.add('show');
    resultContainer.style.display = 'none';
    errorContainer.style.display = 'none';
    analyzeBtn.disabled = true;

    try {
      const response = await fetch('/api/gap-analysis', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ docId1, docId2 })
      });

      const data = await response.json();

      if (data.success) {
        // Show document info
        document.getElementById('docInfo').innerHTML = `
          <div class="doc-badge"><strong>Doc A:</strong> ${data.documents.docA.name} (${data.documents.docA.pages} pages)</div>
          <div class="doc-badge"><strong>Doc B:</strong> ${data.documents.docB.name} (${data.documents.docB.pages} pages)</div>
        `;

        // Show truncation warning if needed
        document.getElementById('truncationWarning').style.display = data.truncated ? 'block' : 'none';

        // Show analysis
        document.getElementById('analysisContent').innerHTML = formatAnalysis(data.analysis);
        resultContainer.style.display = 'block';
      } else {
        errorContainer.textContent = data.error || 'Analysis failed. Please try again.';
        errorContainer.style.display = 'block';
      }
    } catch (error) {
      console.error('Analysis error:', error);
      errorContainer.textContent = 'Failed to connect to server. Please try again.';
      errorContainer.style.display = 'block';
    } finally {
      loading.classList.remove('show');
      analyzeBtn.disabled = false;
    }
  }
</script>
</body>
</html>
