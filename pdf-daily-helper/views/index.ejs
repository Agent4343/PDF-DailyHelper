<!DOCTYPE html>
<html lang="en">
<%- include('partials/_head.ejs') %>
<style>
  .upload-card {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .upload-tabs .nav-link {
    color: #495057;
  }
  .upload-tabs .nav-link.active {
    color: #0d6efd;
    font-weight: 500;
  }
  .file-count-badge {
    background: #0d6efd;
    color: white;
    border-radius: 12px;
    padding: 0.1rem 0.5rem;
    font-size: 0.8rem;
    margin-left: 0.5rem;
  }
  .upload-progress {
    display: none;
  }
  .upload-progress.show {
    display: block;
  }
  .drop-zone {
    border: 2px dashed #dee2e6;
    border-radius: 8px;
    padding: 2rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-bottom: 1rem;
  }
  .drop-zone:hover {
    border-color: #0d6efd;
    background: #f0f7ff;
  }
  .drop-zone.drag-over {
    border-color: #0d6efd;
    background: #e7f1ff;
    transform: scale(1.01);
  }
  .drop-zone-icon {
    font-size: 2.5rem;
    color: #6c757d;
    margin-bottom: 0.5rem;
  }
  .drop-zone.drag-over .drop-zone-icon {
    color: #0d6efd;
  }
</style>
<body>
<%- include('partials/_header.ejs') %>

<main class="container mt-4" role="main">
  <h1>PDF Daily Helper</h1>
  <p class="text-muted">Upload, search, and analyze your PDF documents with AI</p>

  <div class="upload-card">
    <ul class="nav nav-tabs upload-tabs mb-3" role="tablist">
      <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#singleUpload">Single Upload</button>
      </li>
      <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#batchUpload">Batch Upload</button>
      </li>
    </ul>

    <div class="tab-content">
      <!-- Single Upload -->
      <div class="tab-pane fade show active" id="singleUpload">
        <form id="singleUploadForm" enctype="multipart/form-data">
          <div class="drop-zone" id="singleDropZone">
            <div class="drop-zone-icon">📄</div>
            <p class="mb-1"><strong>Drag & drop a PDF here</strong></p>
            <p class="text-muted mb-0">or click to browse</p>
          </div>
          <input type="file" class="d-none" id="pdfFile" name="pdfFile" accept=".pdf" required>
          <div id="singleFileInfo" class="alert alert-info d-none mb-3">
            <span id="singleFileName"></span>
            <button type="button" class="btn-close float-end" onclick="clearSingleFile()"></button>
          </div>
          <div class="mb-3">
            <label for="autoDelete" class="form-label">Auto-delete after (optional)</label>
            <select class="form-select" id="autoDelete" name="autoDelete">
              <option value="">Never (keep forever)</option>
              <option value="1">1 hour</option>
              <option value="24">24 hours</option>
              <option value="168">7 days</option>
              <option value="720">30 days</option>
            </select>
            <small class="text-muted">Document will be automatically deleted after this time</small>
          </div>
          <button type="submit" class="btn btn-primary" id="singleUploadBtn">Upload</button>
        </form>
      </div>

      <!-- Batch Upload -->
      <div class="tab-pane fade" id="batchUpload">
        <form id="batchUploadForm" enctype="multipart/form-data">
          <div class="drop-zone" id="batchDropZone">
            <div class="drop-zone-icon">📚</div>
            <p class="mb-1"><strong>Drag & drop multiple PDFs here</strong></p>
            <p class="text-muted mb-0">or click to browse (max 10 files, 5MB each)</p>
          </div>
          <input type="file" class="d-none" id="pdfFiles" name="pdfFiles" accept=".pdf" multiple required>
          <div id="batchFileInfo" class="alert alert-info d-none mb-3">
            <span id="fileCountBadge" class="file-count-badge">0</span> files selected
            <button type="button" class="btn-close float-end" onclick="clearBatchFiles()"></button>
          </div>
          <div class="mb-3">
            <label for="batchAutoDelete" class="form-label">Auto-delete after (optional)</label>
            <select class="form-select" id="batchAutoDelete" name="autoDelete">
              <option value="">Never (keep forever)</option>
              <option value="1">1 hour</option>
              <option value="24">24 hours</option>
              <option value="168">7 days</option>
              <option value="720">30 days</option>
            </select>
            <small class="text-muted">Documents will be automatically deleted after this time</small>
          </div>
          <button type="submit" class="btn btn-primary" id="batchUploadBtn">Upload All</button>
        </form>
      </div>
    </div>

    <div class="upload-progress mt-3" id="uploadProgress">
      <div class="progress">
        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
      </div>
      <p class="text-muted mt-2 mb-0" id="uploadStatus">Uploading...</p>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Uploaded PDFs</h2>
    <span class="text-muted" id="pdfCount"></span>
  </div>

  <ul class="list-group" id="pdfList">
    <li class="list-group-item text-muted">Loading PDFs...</li>
  </ul>
</main>

<%- include('partials/_footer.ejs') %>

<script>
  // Drag and drop for single upload
  const singleDropZone = document.getElementById('singleDropZone');
  const singleFileInput = document.getElementById('pdfFile');
  const singleFileInfo = document.getElementById('singleFileInfo');
  const singleFileName = document.getElementById('singleFileName');

  singleDropZone.addEventListener('click', () => singleFileInput.click());

  singleDropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    singleDropZone.classList.add('drag-over');
  });

  singleDropZone.addEventListener('dragleave', () => {
    singleDropZone.classList.remove('drag-over');
  });

  singleDropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    singleDropZone.classList.remove('drag-over');
    const files = Array.from(e.dataTransfer.files).filter(f => f.type === 'application/pdf');
    if (files.length > 0) {
      const dt = new DataTransfer();
      dt.items.add(files[0]);
      singleFileInput.files = dt.files;
      updateSingleFileInfo();
    }
  });

  singleFileInput.addEventListener('change', updateSingleFileInfo);

  function updateSingleFileInfo() {
    if (singleFileInput.files.length > 0) {
      singleFileName.textContent = singleFileInput.files[0].name;
      singleFileInfo.classList.remove('d-none');
      singleDropZone.classList.add('d-none');
    }
  }

  function clearSingleFile() {
    singleFileInput.value = '';
    singleFileInfo.classList.add('d-none');
    singleDropZone.classList.remove('d-none');
  }

  // Drag and drop for batch upload
  const batchDropZone = document.getElementById('batchDropZone');
  const batchFileInput = document.getElementById('pdfFiles');
  const batchFileInfo = document.getElementById('batchFileInfo');
  const fileCountBadge = document.getElementById('fileCountBadge');

  batchDropZone.addEventListener('click', () => batchFileInput.click());

  batchDropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    batchDropZone.classList.add('drag-over');
  });

  batchDropZone.addEventListener('dragleave', () => {
    batchDropZone.classList.remove('drag-over');
  });

  batchDropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    batchDropZone.classList.remove('drag-over');
    const files = Array.from(e.dataTransfer.files).filter(f => f.type === 'application/pdf').slice(0, 10);
    if (files.length > 0) {
      const dt = new DataTransfer();
      files.forEach(f => dt.items.add(f));
      batchFileInput.files = dt.files;
      updateBatchFileInfo();
    }
  });

  batchFileInput.addEventListener('change', updateBatchFileInfo);

  function updateBatchFileInfo() {
    if (batchFileInput.files.length > 0) {
      fileCountBadge.textContent = batchFileInput.files.length;
      batchFileInfo.classList.remove('d-none');
      batchDropZone.classList.add('d-none');
    }
  }

  function clearBatchFiles() {
    batchFileInput.value = '';
    batchFileInfo.classList.add('d-none');
    batchDropZone.classList.remove('d-none');
  }

  // Single upload handler
  document.getElementById('singleUploadForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const form = this;
    const btn = document.getElementById('singleUploadBtn');
    const progress = document.getElementById('uploadProgress');
    const status = document.getElementById('uploadStatus');

    btn.disabled = true;
    progress.classList.add('show');
    status.textContent = 'Uploading...';

    try {
      const formData = new FormData(form);
      const response = await fetch('/api/upload', {
        method: 'POST',
        body: formData
      });

      if (response.ok) {
        status.textContent = 'Upload complete!';
        form.reset();
        clearSingleFile();
        setTimeout(() => {
          progress.classList.remove('show');
          fetchPDFs();
        }, 1000);
      } else {
        throw new Error('Upload failed');
      }
    } catch (error) {
      status.textContent = 'Upload failed. Please try again.';
      setTimeout(() => progress.classList.remove('show'), 2000);
    } finally {
      btn.disabled = false;
    }
  });

  // Batch upload handler
  document.getElementById('batchUploadForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const form = this;
    const btn = document.getElementById('batchUploadBtn');
    const progress = document.getElementById('uploadProgress');
    const status = document.getElementById('uploadStatus');
    const fileCount = document.getElementById('pdfFiles').files.length;

    btn.disabled = true;
    progress.classList.add('show');
    status.textContent = `Uploading ${fileCount} files...`;

    try {
      const formData = new FormData(form);
      const response = await fetch('/api/upload/batch', {
        method: 'POST',
        body: formData
      });

      const data = await response.json();

      if (data.success) {
        status.textContent = data.message;
        form.reset();
        clearBatchFiles();
        setTimeout(() => {
          progress.classList.remove('show');
          fetchPDFs();
        }, 1500);
      } else {
        throw new Error(data.error || 'Upload failed');
      }
    } catch (error) {
      status.textContent = 'Upload failed. Please try again.';
      setTimeout(() => progress.classList.remove('show'), 2000);
    } finally {
      btn.disabled = false;
    }
  });
</script>
</body>
</html>
