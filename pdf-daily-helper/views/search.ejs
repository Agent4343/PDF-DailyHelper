<!DOCTYPE html>
<html lang="en">
<%- include('partials/_head.ejs') %>
<body>
<%- include('partials/_header.ejs') %>

<main class="container py-4" role="main">
  <section class="page-hero mb-4">
    <div class="d-flex flex-column gap-2 position-relative">
      <div class="d-flex flex-wrap gap-2">
        <span class="badge-soft align-self-start">Semantic Search</span>
        <% if (features && features.ocrEnabled) { %>
          <span class="badge-soft align-self-start" style="background: rgba(16, 185, 129, 0.18); color: #065f46;">
            OCR: <%= (features.ocrProvider || 'ENABLED').toUpperCase() %>
          </span>
        <% } else { %>
          <span class="badge-soft align-self-start" style="background: rgba(249, 115, 22, 0.18); color: #c2410c;">
            OCR disabled
          </span>
        <% } %>
      </div>
      <h1 class="display-6 fw-semibold mb-1">Find exactly what you need inside your PDFs</h1>
      <p class="lead text-white-50 mb-0">Combine full-text, date, and filename filters, then jump straight to the relevant chunks.</p>
    </div>
  </section>

  <section class="card-elevated mb-4">
    <form id="searchForm">
      <div class="row g-3">
        <div class="col-lg-5">
          <label for="searchQuery" class="form-label fw-semibold">Search query</label>
          <input type="text" class="form-control form-control-lg" id="searchQuery" name="query" placeholder="e.g. payment schedule clause" required>
        </div>
        <div class="col-lg-3">
          <label for="dateFilter" class="form-label fw-semibold">Date uploaded</label>
          <select class="form-select" id="dateFilter" name="dateFilter">
            <option value="">Any time</option>
            <option value="1d">Past 24 hours</option>
            <option value="7d">Past week</option>
            <option value="30d">Past month</option>
            <option value="365d">Past year</option>
          </select>
        </div>
        <div class="col-lg-2">
          <label for="fileNameFilter" class="form-label fw-semibold">File name</label>
          <input type="text" class="form-control" id="fileNameFilter" name="fileNameFilter" placeholder="proposal">
        </div>
        <div class="col-lg-2">
          <label for="pageNumberFilter" class="form-label fw-semibold">Page #</label>
          <input type="number" class="form-control" id="pageNumberFilter" name="pageNumberFilter" placeholder="1">
        </div>
      </div>
      <div class="d-flex justify-content-end mt-3">
        <button class="btn btn-primary btn-lg px-5" type="submit">Search PDFs</button>
      </div>
    </form>
  </section>

  <div class="row g-4">
    <div class="col-lg-8">
      <div id="searchResults">
        <div class="skeleton" style="height: 140px;"></div>
      </div>
      <nav aria-label="Search results pages" class="mt-3">
        <ul class="pagination justify-content-center" id="pagination"></ul>
      </nav>
    </div>
    <div class="col-lg-4">
      <div class="card-elevated">
        <div class="card-header">
          <div>
            <h3 class="h5 mb-0">Active filters</h3>
            <small class="text-muted">Quickly toggle search scopes</small>
          </div>
        </div>
        <div id="activeFilters" class="d-flex flex-wrap gap-2">
          <span class="text-muted">No filters applied.</span>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/_footer.ejs') %>